# Copiaza acest fisier in .env si completeaza valorile pentru masina ta locala.
# .env este in .gitignore - nu se comite, e specific fiecarui developer.

# IP-ul WSL2 vazut de containerele Docker Desktop, folosit ca Prometheus sa poata
# scrape-ui control-api care ruleaza direct pe host (nu in container), pe portul 8080.
# Determina-l cu: hostname -I | awk '{print $1}'
# Atentie: se poate schimba dupa fiecare restart de WSL/Windows.
WSL_HOST_IP=172.29.163.23

# Optionale, au deja valori implicite in compose.yaml
POSTGRES_DB=envforge
POSTGRES_USER=envforge
POSTGRES_PASSWORD=envforge-local-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=envforge-local-admin
